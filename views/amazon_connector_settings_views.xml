<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_amazon_connector_settings_form" model="ir.ui.view">
        <field name="name">amazon.connector.settings.form</field>
        <field name="model">amazon.connector.settings</field>
        <field name="arch" type="xml">
            <form string="Amazon Connector Settings">
                <sheet>
                    <h2>Amazon Connector Settings</h2>
                    <group name="amazon_connector_settings_root"/>
                </sheet>
                <footer>
                    <button string="Save" type="object" name="set_values" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="amazon_connector_settings_action" model="ir.actions.act_window">
        <field name="name">Advanced Settings</field>
        <field name="res_model">amazon.connector.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_amazon_connector_settings"
              name="Advanced Settings"
              parent="amazon_connector.menu_amazon_connector_config"
              action="amazon_connector_settings_action"
              sequence="40"/>

</odoo>
